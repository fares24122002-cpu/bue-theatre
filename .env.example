# Copy this file to .env.local and fill in the values.
# Supabase: Project Settings > API (and API Keys).

# Project URL, for example https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (called "anon" key on older projects). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret / service role key. SERVER ONLY. Never commit it, never put NEXT_PUBLIC_ in front of it.
SUPABASE_SERVICE_ROLE_KEY=

# Where the site lives (used in emails and QR links). Use the Vercel URL once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails (optional until set up; the site works without them but sends no email).
# Any SMTP account works. For a free Gmail account: turn on 2-step verification,
# create an App password (Google Account > Security > App passwords), then:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=your@gmail.com
#   SMTP_PASS=<the 16-letter app password>  MAIL_FROM="BUE Theatre <your@gmail.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Alternative to SMTP: Resend (https://resend.com). Needs your own verified domain to
# email strangers (ticket buyers). If SMTP_* is set above, it is used instead.
RESEND_API_KEY=
EMAIL_FROM=
